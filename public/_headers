/
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/mobile
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/mobile/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/cache-recovery.html
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/sw.js
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Service-Worker-Allowed: /

/version.json
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/manifest.webmanifest
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/assets/:fingerprinted
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

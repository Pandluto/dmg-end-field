{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "moduleSuffixes": [".desktop", ""],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "worker", "db"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/components/CanvasBoard/index.tsx",
    "src/components/CanvasBoard/SkillSandbox.tsx",
    "src/components/WorkbenchFrame/WorkbenchFrame.tsx",
    "src/context/AppContext.tsx",
    "src/core/services/selectionWorkspaceTransition.ts",
    "src/utils/mainWorkbenchControl.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}

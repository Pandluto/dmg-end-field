[Unit]
Description=DMG Endfield tactical share node
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/dmg-end-field-share
Environment=NODE_ENV=production
Environment=DEF_MOBILE_SHARE_HOST=127.0.0.1
Environment=DEF_MOBILE_SHARE_PORT=8787
Environment=DEF_MOBILE_SHARE_DB=/var/lib/dmg-end-field/mobile-shares.sqlite
# Comma-separated exact browser origins. The service also has these official
# origins as defaults; keeping the value here makes the production boundary
# explicit and gives future HTTPS hostnames one place to update.
Environment=DEF_MOBILE_SHARE_ALLOWED_ORIGINS=https://dmgendfield.cloud,https://dmgendfield.online,https://150.158.133.176,http://150.158.133.176,http://127.0.0.1:3030,http://localhost:3030,http://127.0.0.1:31457,http://localhost:31457
ExecStart=/usr/bin/node /opt/dmg-end-field-share/mobile-share-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dmg-end-field

[Install]
WantedBy=multi-user.target

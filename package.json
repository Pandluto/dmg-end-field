{
  "name": "dmg-end-field",
  "private": true,
  "version": "1.8.2",
  "author": "SailStellar <190052366@qq.com>",
  "description": "终末地配装、排轴与伤害计算的离线优先 Web 工作台",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "smoke:timeline-bundle": "node scripts/timeline-bundle-v2-smoke.mjs",
    "dev": "npm run assets:web-prepare && npm run data:web-manifest && vite --host 127.0.0.1 --port 3030",
    "assets:web-manifest": "node scripts/build-web-image-manifest.mjs",
    "assets:web-prepare": "node scripts/prepare-web-image-package.mjs",
    "test": "node scripts/run-ts-test.mjs",
    "test:numeric": "node scripts/run-ts-test.mjs /src/core/calculators/buffPanelCalculator.test.ts /src/core/calculators/buffZoneCalculator.test.ts /src/core/calculators/resistanceZone.test.ts",
    "typecheck": "tsc --noEmit",
    "data:web-normalize": "node scripts/normalize-web-asset-paths.mjs",
    "data:web-manifest": "node scripts/build-web-data-manifest.mjs",
    "build:web": "npm run data:web-manifest && vite build",
    "build:local": "npm run assets:web-prepare && npm run build:web",
    "check:repo": "node scripts/repository-check.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run check:repo && npm run audit:dependencies && npm run typecheck && npm test && npm run smoke:timeline-bundle && npm run build:web",
    "release:verify": "node scripts/check-release-version.mjs",
    "build": "npm run typecheck && npm run build:web",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "fuse.js": "^7.3.0",
    "pinyin-pro": "^3.28.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}

{
  "name": "dmg-end-field",
  "private": true,
  "version": "1.8.2",
  "main": "electron/main.cjs",
  "author": "SailStellar <190052366@qq.com>",
  "description": "Slim LTS 浏览器工作台与独立 Electron 桌面 Shell",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "smoke:timeline-bundle": "node scripts/timeline-bundle-v2-smoke.mjs",
    "dev": "npm run version:web-manifest && npm run assets:web-prepare && npm run data:web-manifest && vite --host 127.0.0.1 --port 3030",
    "dev:e2e": "npm run version:web-manifest && npm run assets:web-prepare && npm run data:web-manifest && vite --host 127.0.0.1 --port 3040",
    "assets:web-manifest": "node scripts/build-web-image-manifest.mjs",
    "assets:web-prepare": "node scripts/prepare-web-image-package.mjs",
    "version:web-manifest": "node scripts/build-web-version-manifest.mjs",
    "version:web-check": "node scripts/build-web-version-manifest.mjs --check",
    "test": "node scripts/run-ts-test.mjs",
    "test:e2e:lts-dual": "node scripts/run-lts-dual-e2e.mjs",
    "test:e2e:lts-slimming": "playwright test tests/e2e/lts-slimming.spec.ts",
    "test:lts-slimming": "npm test && npm run test:e2e:lts-slimming",
    "test:regression": "npm run typecheck && npm test && npm run test:e2e:lts-slimming",
    "test:regression:dual": "npm run test:e2e:lts-dual",
    "legacy-fill-runtime:build": "node scripts/build-legacy-fill-runtime.mjs",
    "test:legacy-fill-core": "node --experimental-strip-types scripts/legacy-fill-core-contract.mjs",
    "test:legacy-fill-repository": "node scripts/legacy-fill-proposal-repository-contract.mjs",
    "test:legacy-fill-host": "node --experimental-strip-types scripts/legacy-fill-host-gateway-contract.mjs",
    "test:legacy-fill-mcp": "npm run legacy-fill-runtime:build && node scripts/legacy-fill-mcp-contract.mjs",
    "test:legacy-fill-curated": "npm run legacy-fill-runtime:build && node scripts/legacy-fill-curated-resources-contract.mjs",
    "smoke:legacy-fill-service": "npm run legacy-fill-runtime:build && node scripts/legacy-fill-service-smoke.mjs",
    "test:legacy-fill": "npm run test:legacy-fill-core && npm run test:legacy-fill-repository && npm run test:legacy-fill-host && npm run smoke:legacy-fill-service && npm run test:legacy-fill-mcp && npm run test:legacy-fill-curated",
    "test:numeric": "node scripts/run-ts-test.mjs /src/core/calculators/buffPanelCalculator.test.ts /src/core/calculators/buffZoneCalculator.test.ts /src/core/calculators/resistanceZone.test.ts",
    "typecheck": "tsc --noEmit",
    "data:web-normalize": "node scripts/normalize-web-asset-paths.mjs",
    "data:web-package": "node scripts/build-web-default-data-package.mjs",
    "data:web-manifest": "npm run data:web-package && node scripts/build-web-data-manifest.mjs",
    "build:web": "npm run version:web-manifest && npm run data:web-manifest && vite build && node scripts/build-atomic-service-worker.mjs dist",
    "build:local": "npm run assets:web-prepare && npm run build:web && npm run legacy-fill-runtime:build",
    "build:sites": "node scripts/clean-sites-build.mjs && npm run version:web-manifest && npm run assets:web-prepare && npm run data:web-manifest && SITES_BUILD=1 vite build && node scripts/build-atomic-service-worker.mjs dist/client && node scripts/prune-sites-image-package.mjs",
    "check:repo": "node scripts/repository-check.mjs",
    "check:offline-shell": "node scripts/check-atomic-service-worker.mjs dist",
    "check:offline-workspace": "node scripts/check-offline-workspace-bootstrap.mjs dist",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run version:web-check && npm run check:repo && npm run audit:dependencies && npm run typecheck && npm test && npm run smoke:timeline-bundle && npm run build:local && npm run check:offline-shell && npm run check:offline-workspace",
    "release:verify": "node scripts/check-release-version.mjs",
    "build": "npm run typecheck && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "npm run legacy-fill-runtime:build && concurrently --kill-others-on-fail --names web,desktop \"npm:dev\" \"npm:electron:dev:launch\"",
    "electron:shell": "npm run electron:dev",
    "electron:dev:launch": "wait-on http-get://127.0.0.1:3030 && electron electron/main.cjs --dev",
    "electron:start": "electron electron/main.cjs",
    "electron:smoke:host": "node scripts/desktop-static-host-smoke.mjs",
    "electron:smoke:worker": "node scripts/check-desktop-resource-worker.mjs",
    "electron:smoke:data-release": "node scripts/desktop-data-release-builder-smoke.mjs",
    "electron:smoke:image-release": "node scripts/desktop-image-release-builder-smoke.mjs",
    "electron:smoke:boundaries": "node scripts/check-desktop-runtime-boundaries.mjs",
    "electron:smoke:package": "node scripts/check-desktop-package.mjs",
    "electron:smoke:app": "node scripts/desktop-electron-smoke.mjs",
    "electron:smoke:packaged:mac": "node scripts/desktop-electron-smoke.mjs --executable \"release/mac-arm64/终末地伤害工作台.app/Contents/MacOS/终末地伤害工作台\"",
    "electron:check": "npm run typecheck && npm run test && npm run test:legacy-fill && npm run electron:smoke:host && npm run electron:smoke:worker && npm run electron:smoke:data-release && npm run electron:smoke:image-release && npm run electron:smoke:boundaries && npm run build:local && npm run electron:smoke:app",
    "electron:build:dir": "npm run build:local && electron-builder --dir",
    "electron:build": "npm run build:local && electron-builder --win portable",
    "electron:build:mac": "npm run build:local && electron-builder --mac dmg --arm64",
    "electron:verify:mac": "npm run electron:build:dir && npm run electron:smoke:package && npm run electron:smoke:packaged:mac"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@ybouane/liquidglass": "1.0.3",
    "fflate": "^0.8.3",
    "fuse.js": "^7.3.0",
    "pinyin-pro": "^3.28.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@electron/asar": "3.4.1",
    "@electron/notarize": "2.5.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "concurrently": "^9.1.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.1",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.3",
    "wrangler": "4.115.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "postcss": "8.5.25",
    "undici": "7.29.0"
  },
  "build": {
    "appId": "com.dmg.def",
    "productName": "终末地伤害工作台",
    "compression": "normal",
    "afterSign": "scripts/notarize.cjs",
    "asarUnpack": [
      "dist/legacy-fill/**"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "electron/assets/icon.png",
    "files": [
      "dist/**",
      "!dist/sw.js",
      "!node_modules/**",
      "electron/**",
      "scripts/build-image-release-manifest.mjs",
      "scripts/build-desktop-data-release.mjs",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    }
  }
}

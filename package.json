{
  "name": "dmg-end-field",
  "private": true,
  "version": "1.8.2",
  "author": "SailStellar <190052366@qq.com>",
  "description": "终末地配装、排轴与伤害计算的离线优先 Web 工作台",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "smoke:work-node-sqlite": "node scripts/ai-timeline-work-node-sqlite-smoke.mjs && node scripts/ai-timeline-work-node-backup-restore-smoke.mjs && node scripts/timeline-migration-smoke.mjs",
    "smoke:timeline-bundle": "node scripts/timeline-bundle-v2-smoke.mjs",
    "smoke:data-management": "node scripts/data-management-service-smoke.mjs",
    "smoke:reference-archive-release": "node scripts/reference-archive-release-smoke.mjs",
    "smoke:data-catalog": "node scripts/data-catalog-build-smoke.mjs",
    "smoke:data-release-builder": "node scripts/data-release-builder-smoke.mjs",
    "smoke:local-data-archive-flow": "node scripts/local-data-archive-flow-smoke.mjs",
    "dev": "npm run data:web-manifest && vite --host 127.0.0.1 --port 3030",
    "assets:release": "node scripts/build-image-release-manifest.mjs",
    "assets:web-manifest": "node scripts/build-web-image-manifest.mjs",
    "assets:web-prepare": "node scripts/prepare-web-image-package.mjs",
    "test": "node scripts/run-ts-test.mjs",
    "test:numeric": "node scripts/run-ts-test.mjs /src/core/calculators/buffPanelCalculator.test.ts /src/core/calculators/buffZoneCalculator.test.ts /src/core/calculators/resistanceZone.test.ts",
    "typecheck": "tsc --noEmit",
    "data:catalog": "node scripts/build-data-catalog.mjs",
    "data:web-manifest": "node scripts/build-web-data-manifest.mjs",
    "data:release": "node scripts/build-data-release-package.mjs",
    "build:web": "npm run data:web-manifest && vite build",
    "check:repo": "node scripts/repository-check.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run check:repo && npm run audit:dependencies && npm run typecheck && npm test && npm run build:web",
    "release:verify": "node scripts/check-release-version.mjs",
    "build": "npm run typecheck && npm run build:web",
    "preview": "vite preview",
    "app:dev": "npm run electron:shell",
    "electron:shell": "concurrently -k \"npm:dev\" \"wait-on tcp:127.0.0.1:3030 && electron . --dev --shell-only\"",
    "electron:dev": "npm run electron:shell",
    "electron:build": "npm run build && electron-builder --win portable",
    "electron:build:mac": "npm run build && electron-builder --mac dmg --publish never",
    "electron:build:mac:dir": "npm run build && electron-builder --mac dir --publish never"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "fuse.js": "^7.3.0",
    "pinyin-pro": "^3.28.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.1.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "build": {
    "appId": "com.dmg.def",
    "productName": "终末地伤害工作台",
    "compression": "normal",
    "afterSign": "scripts/notarize.cjs",
    "directories": {
      "output": "release"
    },
    "icon": "electron/assets/icon.png",
    "files": [
      "dist/**",
      "electron/**",
      "scripts/build-data-release-package.mjs",
      "scripts/build-image-release-manifest.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "dist/data/catalog.sqlite"
    ],
    "electronLanguages": [
      "zh-CN"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
